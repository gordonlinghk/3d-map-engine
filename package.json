{
  "name": "map-engine-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Procedural 3D city map engine — reusable SDK + browser demo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @map-engine/demo dev",
    "build": "pnpm --filter @map-engine/demo build",
    "build:lib": "pnpm --filter '@map-engine/*' --filter '!@map-engine/demo' run build",
    "release": "pnpm build:lib && pnpm -r --filter '!@map-engine/demo' publish --access public --no-git-checks",
    "preview": "pnpm --filter @map-engine/demo preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint packages/*/src",
    "typecheck": "tsc -b packages/core packages/osm packages/terrain packages/historical packages/three packages/ui packages/demo",
    "bake": "tsx scripts/bake-city.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@map-engine/core": "workspace:*",
    "@map-engine/osm": "workspace:*",
    "@map-engine/terrain": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.30.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}

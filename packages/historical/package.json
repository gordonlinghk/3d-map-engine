{
  "name": "@map-engine/historical",
  "version": "0.1.0",
  "description": "Historical map data packs for @map-engine/core — hand-curated strategy-scale worlds (Three Kingdoms China) with provenance and confidence annotations.",
  "license": "MIT",
  "author": "Gordon Ling",
  "homepage": "https://gordonlinghk.github.io/3d-map-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonlinghk/3d-map-engine.git",
    "directory": "packages/historical"
  },
  "keywords": ["historical", "three-kingdoms", "gis", "3d", "map"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "sideEffects": false,
  "dependencies": {
    "@map-engine/core": "workspace:*"
  }
}

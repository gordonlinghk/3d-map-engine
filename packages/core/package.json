{
  "name": "@map-engine/core",
  "version": "0.1.0",
  "description": "Deterministic procedural 3D city map generation — data model, seeded RNG, terrain/road/city generation, serialization. Zero DOM/Three.js dependencies.",
  "license": "MIT",
  "author": "Gordon Ling",
  "homepage": "https://gordonlinghk.github.io/3d-map-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonlinghk/3d-map-engine.git",
    "directory": "packages/core"
  },
  "keywords": ["procedural-generation", "3d", "map", "city", "terrain", "deterministic"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "sideEffects": false
}

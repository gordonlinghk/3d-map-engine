{
  "name": "@map-engine/game",
  "version": "0.1.0",
  "description": "Game-logic layer for @map-engine/core — A* pathfinding over the road graph, deterministic unit movement and a lightweight event-driven simulation. Zero DOM/Three.js dependencies.",
  "license": "MIT",
  "author": "Gordon Ling",
  "homepage": "https://gordonlinghk.github.io/3d-map-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonlinghk/3d-map-engine.git",
    "directory": "packages/game"
  },
  "keywords": ["pathfinding", "a-star", "simulation", "game", "3d", "map"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "sideEffects": false,
  "dependencies": {
    "@map-engine/core": "workspace:*"
  }
}
